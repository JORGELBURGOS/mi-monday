# -----------------------------------------------------------------------------
# Mi Monday · variables de entorno
# Copiá este archivo a .env.local y completá los valores. Nunca subas .env.local.
# -----------------------------------------------------------------------------

# URL del proyecto de Supabase (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave PÚBLICA de Supabase (formato sb_publishable_...). Es segura en el navegador
# porque todas las tablas tienen Row Level Security.
# Alternativa para proyectos viejos: NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_reemplazar

# Opcional: URL pública de la app, usada en los enlaces de los emails.
# Si no se define, se toma del dominio de cada request.
NEXT_PUBLIC_SITE_URL=

# Opcional: nombre de la app que se muestra en la interfaz (por defecto "Mi Monday").
NEXT_PUBLIC_APP_NAME=

# IMPORTANTE: esta app NO usa ni necesita la clave service_role. No la agregues.
